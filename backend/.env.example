# Aura Music Platform — PostgreSQL & Backend Environment Configuration

# 1. PostgreSQL Database URL (Render / Supabase / Neon / Local PostgreSQL)
# Example Render: postgresql://aura_admin:YOUR_PASSWORD@dpg-cu1234567-a.oregon-postgres.render.com/aura_music
# Example Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/aura_music
DATABASE_URL=postgresql://aura_admin:password@localhost:5432/aura_music

# 2. Port & CORS
PORT=8001
CORS_ORIGINS=*
ENVIRONMENT=development
